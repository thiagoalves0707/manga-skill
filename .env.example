# Copie este arquivo para ".env" (na mesma pasta) e cole a SUA chave do Gemini.
# Crie a chave em: https://aistudio.google.com/apikey
# A geração de imagem exige faturamento ativo no projeto da chave (o plano gratuito tem limite 0 para imagens).
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: trocar o modelo de imagem (liste os disponíveis com: node scripts/gen.mjs --list-models)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
